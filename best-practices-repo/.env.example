# Copy this file to .env and fill in real values for local dev.
# Never commit .env — it's already in .gitignore.

# Required by config/webhook.js. Get the real value from the payment
# provider dashboard / secrets manager, never hardcode it in source.
PAYMENT_WEBHOOK_SECRET=changeme

# Database connection (fill in from your secrets manager, not from a
# teammate's Slack message).
DB_HOST=changeme
DB_USER=changeme
DB_PASSWORD=changeme

# AWS credentials — prefer an IAM role over static keys where possible.
AWS_ACCESS_KEY_ID=changeme
AWS_SECRET_ACCESS_KEY=changeme

# Used to sign/verify auth tokens.
JWT_SIGNING_SECRET=changeme

# Optional, defaults to 8080 if unset.
PORT=8080
